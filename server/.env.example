# Set AETHERION_DOMAIN after choosing a domain that resolves to this VPS.
AETHERION_DOMAIN=aetherionlbs.duckdns.org

# Generate a random secret of at least 32 characters. Never commit the real .env.
AETHERION_ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters

# Copy the full hexadecimal PUBLIC_KEY_N from src/local_ai_benchmark/client/licensing.py.
AETHERION_LICENSE_PUBLIC_KEY_N=replace-with-PUBLIC_KEY_N

# Keep the real token only in the untracked, owner-only server .env.
DUCKDNS_TOKEN=replace-with-your-private-duckdns-token
